# Server
PORT=5000
NODE_ENV=production

# Cafe
CAFE_NAME=Cafe ERP
ADMIN_PHONE=9999999999
# Required: admin login is disabled until this is set. Use a strong, unique password per cafe.
ADMIN_PASSWORD=

# MongoDB (one database per cafe)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<cafe-db-name>

# JWT (generate a unique one per cafe: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# SMS OTP (2factor.in). Without it, OTPs are only printed in the server log.
SMS_PROVIDER=twofactor
SMS_API_KEY=

# Cloudflare R2 image storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Frontend URL (for CORS), e.g. https://chaipoint.vercel.app
FRONTEND_URL=
