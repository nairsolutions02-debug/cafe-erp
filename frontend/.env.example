# Supabase project (Settings -> API). The anon key is safe to expose in the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# SMS OTP login: leave false (customers sign in with name + mobile)
VITE_OTP_LOGIN=false

# Cafe branding (set these per cafe in its Vercel project)
VITE_CAFE_NAME=Cafe ERP
VITE_CAFE_TAGLINE=Fresh food, served fast
VITE_CAFE_THEME_COLOR="#C87316"
# Full URL to the logo; defaults to /logo.svg
VITE_CAFE_LOGO_URL=
VITE_CAFE_ADDRESS=
VITE_CAFE_PHONE=
VITE_CAFE_EMAIL=
VITE_CAFE_INSTAGRAM=
VITE_CAFE_FACEBOOK=
VITE_CAFE_HOURS_DAYS=Mon - Sun
VITE_CAFE_HOURS_TIME=9:00 AM - 10:00 PM
# Home page hero
VITE_CAFE_HERO_BADGE=🍽️ Freshly Made
VITE_CAFE_HERO_TEXT=Every dish is crafted with love and fresh ingredients. Order right from your table!
VITE_CAFE_HERO_IMAGE_URL=
# Pipe-separated "value:label" pairs; leave empty to hide
VITE_CAFE_STATS=
# Pipe-separated rotating search placeholders
VITE_CAFE_SEARCH_HINTS=Search the menu...|Find your favorite dish...
